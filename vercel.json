{
  "buildCommand": "npm run prisma:deploy && npm run auth:seed && npm run build:all",
  "outputDirectory": "dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
